{
  "uid": "s7sim-line",
  "title": "Filling line",
  "tags": [
    "s7-sim"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Line state",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "s7sim-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "s7sim-prom"
          },
          "expr": "s7_tag_value{plc=\"filling_line\",tag=\"running\"}",
          "legendFormat": "running",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "stopped",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "running",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Filler temperature",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "s7sim-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "s7sim-prom"
          },
          "expr": "s7_tag_value{plc=\"filling_line\",tag=\"filler_temp\"}",
          "legendFormat": "actual",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "s7sim-prom"
          },
          "expr": "s7_tag_value{plc=\"filling_line\",tag=\"target_temp\"}",
          "legendFormat": "target",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "celsius"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Current stop",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "s7sim-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "s7sim-prom"
          },
          "expr": "s7_tag_value{plc=\"filling_line\",tag=\"stopped_for\"}",
          "legendFormat": "stopped for",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Line speed",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "s7sim-prom"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "s7sim-prom"
          },
          "expr": "s7_tag_value{plc=\"filling_line\",tag=\"line_speed\"}",
          "legendFormat": "setpoint",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Bottles per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "s7sim-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "s7sim-prom"
          },
          "expr": "rate(s7_tag_value{plc=\"filling_line\",tag=\"bottles_filled\"}[1m]) * 60",
          "legendFormat": "filled",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "s7sim-prom"
          },
          "expr": "rate(s7_tag_value{plc=\"filling_line\",tag=\"bottles_rejected\"}[1m]) * 60",
          "legendFormat": "rejected",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Totals this session",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "s7sim-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "s7sim-prom"
          },
          "expr": "s7_tag_value{plc=\"filling_line\",tag=\"bottles_filled\"}",
          "legendFormat": "filled",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "s7sim-prom"
          },
          "expr": "s7_tag_value{plc=\"filling_line\",tag=\"bottles_rejected\"}",
          "legendFormat": "rejected",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Controller reachable",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "s7sim-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "s7sim-prom"
          },
          "expr": "s7_up{plc=\"filling_line\"}",
          "legendFormat": "up",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "s7sim-prom"
          },
          "expr": "s7_tag_read_ok{plc=\"filling_line\"}",
          "legendFormat": "{{tag}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "fail",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "ok",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0
          }
        },
        "overrides": []
      }
    }
  ]
}
